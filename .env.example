# Supabase — get these from your project's API keys settings:
# https://app.supabase.com/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...), browser-safe. Replaces the deprecated anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Secret key (sb_secret_...), server-only — never expose to the browser.
# Replaces the deprecated service_role key; bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Optional dedicated pepper for hashing shared-secret answers. If omitted, the
# app falls back to another server-only secret, but production should set this.
# Generate a strong value, e.g.: openssl rand -base64 32
LETTER_SECRET_PEPPER=your-letter-secret-pepper

# Postgres connection string used by Drizzle ORM (server-only).
# The db client is created with `prepare: false` for compatibility with
# Supabase's transaction-mode pooler (port 6543). That option is harmless
# on a direct connection as well.
# For running Drizzle migrations (drizzle-kit push/migrate) a direct,
# non-pooled, session-mode connection is recommended:
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:6543/postgres

# Public base URL of the app, used for auth email redirect links.
# e.g. http://localhost:3000 in dev, https://yourdomain.com in production.
NEXT_PUBLIC_SITE_URL=https://hermesletters.vercel.app

# Secret for the scheduled expiry job; sent by the cron platform as
# 'Authorization: Bearer <CRON_SECRET>'.
# Generate a strong random value, e.g.: openssl rand -base64 32
CRON_SECRET=your-cron-secret
