# Supabase — get these from your project's API settings:
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string used by Drizzle ORM (server-only).
# The db client is created with `prepare: false` for compatibility with
# Supabase's transaction-mode pooler (port 6543). That option is harmless
# on a direct connection as well.
# For running Drizzle migrations (drizzle-kit push/migrate) a direct,
# non-pooled, session-mode connection is recommended:
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Public base URL of the app, used for auth email redirect links.
# e.g. http://localhost:3000 in dev, https://yourdomain.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
